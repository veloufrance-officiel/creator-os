# Copier en .env et adapter. Ne jamais committer .env (voir .gitignore).

# --- Infrastructure locale (infrastructure/docker/docker-compose.yml) ---
POSTGRES_USER=creator_os
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=creator_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ROOT_USER=creator_os
MINIO_ROOT_PASSWORD=local_dev_only
MINIO_ENDPOINT=localhost:9000

# --- services/identity (Sprint F1) ---
# DATABASE_URL doit pointer vers Postgres en production (voir infrastructure/docker).
DATABASE_URL=postgresql+asyncpg://creator_os:local_dev_only@localhost:5432/creator_os
# RS256 (ADR-0008) — clés PEM réelles requises en production ; vide en dev =
# paire générée en mémoire au démarrage (non persistante, dev uniquement).
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=identity-dev-key-1
# Secret distinct pour le state OAuth anti-CSRF (HS256, interne à identity uniquement)
OAUTH_STATE_SECRET=changeme-generate-a-real-secret-before-any-deploy
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# OAuth Google (voir services/identity/SPEC.md et ADR-0006) — à créer sur Google Cloud
# Console ; sans valeurs réelles, l'app démarre mais /auth/oauth/google/* échouera.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Sign-in natif multi-plateforme (mobile + web SDK) — voir ADR-0007. Un ID par
# plateforme (web, iOS, Android...), séparés par des virgules.
GOOGLE_OAUTH_CLIENT_IDS=
# Apple Developer : Services ID (web) et/ou bundle ID (app native), séparés par virgules.
APPLE_CLIENT_IDS=

# --- À compléter au fil des sprints suivants (non fonctionnel à ce stade) ---
# AI Core (services/ai)      : OPENAI_API_KEY=, ANTHROPIC_API_KEY=, GOOGLE_API_KEY=, MISTRAL_API_KEY=
# Billing (services/billing) : STRIPE_SECRET_KEY= (fournisseur pressenti, non tranché)
